# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / PostGIS connection string (e.g. postgres://user:password@host:5432/dbname)
DATABASE_URL=""

# Supabase alternatives if using Supabase directly
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mapping & Geolocation API (Mapbox or Google Maps, optional - Leaflet OSM used as default zero-cost live map)
NEXT_PUBLIC_MAPS_API_KEY=""

# SMS / Notification Provider (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
